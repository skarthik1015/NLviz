# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Postgres password for the app database (any strong random string).
POSTGRES_PASSWORD=

# Fernet key for connection credentials at rest. Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=

# The one Jammi tenant NLviz binds to (a UUID v4). Generate once and keep it:
#   python -c "import uuid; print(uuid.uuid4())"
JAMMI_SERVICE_TENANT=

# Local development login (no Cognito). Refused at startup when ENVIRONMENT=production.
DEV_USER_ID=demo-user
# Behind an ALB with OIDC instead: trust only the ALB-signed x-amzn-oidc-data token, from this ALB.
# TRUST_PROXY_IDENTITY=true
# ALB_ARN=arn:aws:elasticloadbalancing:<region>:<account>:loadbalancer/app/<name>/<id>

# Question limits per user, on every question route.
# RATE_LIMIT_RPM=30
# MAX_CONCURRENT_QUESTIONS=2

# LLM (OpenAI-compatible). Default: Ollama on the host. Ollama's default context (4096 tokens) is too
# small for schema generation, so create an 8k variant of the model once:
#   ollama pull qwen3:4b-instruct
#   printf 'FROM qwen3:4b-instruct\nPARAMETER num_ctx 8192\n' > Modelfile && ollama create qwen3:4b-instruct-8k -f Modelfile
# Switching models is configuration only (providers live in backend/app/llm.py):
#   OpenAI:    LLM_PROVIDER=openai     LLM_MODEL=gpt-4.1-mini        OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_API_KEY=sk-...
#   Anthropic: LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-5   ANTHROPIC_API_KEY=sk-ant-...
#   Local:     the four lines below (back to Ollama at any time).
# One task can use another model: LLM_PROVIDER_<TASK> / LLM_MODEL_<TASK> with TASK = INTENT, ANSWERABILITY,
# EXPLAIN or SCHEMA, e.g. LLM_PROVIDER_SCHEMA=anthropic + LLM_MODEL_SCHEMA=claude-sonnet-4-5 + ANTHROPIC_API_KEY
# with the rest local. (OPENAI_BASE_URL is shared, so local Ollama and hosted OpenAI cannot be mixed;
# local + Anthropic can.)
LLM_PROVIDER=openai
LLM_MODEL=qwen3:4b-instruct-8k
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama

# The check rules that react to the question's wording (backend/app/agent/nodes/intent_mapper.py,
# PHRASE_REWRITES). "off" only for measuring what they add (docs/plan-next.md, step 0a).
PHRASE_REWRITES=on
# Answer questions the semantic layer cannot (or that cannot be interpreted) with SQL the model
# writes, guarded and labelled "generated SQL" (backend/app/agent/nodes/sql_fallback.py).
SQL_FALLBACK=off
# sql: answer with guarded SQL held to the semantic layer's definitions (docs/plan-next.md decision gate);
# semantic: the intent and compiler. Explicit intents always use the compiler.
ANSWER_PATH=sql
# on: an unconfirmed metric condition that changes the answer (revenue without canceled orders) is
# asked about; answers hold for the conversation, or for the connection when the user ticks "remember".
DEFINITION_CLARIFICATIONS=on

# Query MySQL live instead of importing a snapshot. Off: Jammi issue J27 (wrong results).
MYSQL_FEDERATION=false
